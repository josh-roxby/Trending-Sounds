# Copy to .env.local and fill in. NEVER commit secrets.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chartex (https://api.chartex.com)
CHARTEX_APP_ID=
CHARTEX_APP_TOKEN=

# Cron auth — random long string, used by /api/cron/daily-snapshot
CRON_SECRET=

# Public site URL — used for OAuth redirects. Use your Vercel URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
